# Copy this file to .env (repo root, and/or payment-service/.env) and fill in
# real values for local development. Never commit the actual .env file.

# ---------------------------------------------------------------------------
# JWT (account-service issues tokens, api-gateway validates them)
# Both services MUST use the same secret. If unset, a safe insecure dev
# default is used automatically so the system still runs out of the box -
# override this for anything beyond local development.
# ---------------------------------------------------------------------------
JWT_SECRET=dev-only-insecure-default-change-me-please-this-is-32bytes-min

# ---------------------------------------------------------------------------
# Firebase Cloud Messaging (notification-service)
# Path to a Firebase service-account JSON credentials file. If unset,
# notification-service logs a warning at startup and skips push
# notifications gracefully - the service still runs without it.
# ---------------------------------------------------------------------------
FIREBASE_CREDENTIALS_PATH=

# ---------------------------------------------------------------------------
# Stripe (payment-service) - use your own test keys from
# https://dashboard.stripe.com/test/apikeys
# ---------------------------------------------------------------------------
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
